# Production builds must pass digest-pinned images, for example:
#   --build-arg NODE_IMAGE=node@sha256:<digest>
#   --build-arg NGINX_IMAGE=nginx@sha256:<digest>
ARG NODE_IMAGE
ARG NGINX_IMAGE

FROM ${NODE_IMAGE} AS build
WORKDIR /workspace

COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts

COPY . .
RUN npm exec vue-tsc -- --noEmit -p tsconfig.portal.json \
    && npm exec vite -- build --config vite.portal.config.ts \
    && test -f dist-portal/portal.html \
    && test -f dist-portal/.vite/manifest.json \
    && ! grep -RInE '(client[_-]?secret|BEGIN (RSA|OPENSSH|EC) PRIVATE KEY|Bearer[[:space:]]+[A-Za-z0-9._-]{20,})' dist-portal

FROM ${NGINX_IMAGE} AS runtime

COPY deploy/frontend/nginx.portal.conf /etc/nginx/conf.d/default.conf
COPY deploy/frontend/entrypoint.sh /usr/local/bin/freight-portal-entrypoint
COPY --from=build /workspace/dist-portal/ /usr/share/nginx/html/

RUN chmod 0755 /usr/local/bin/freight-portal-entrypoint \
    && chown -R nginx:nginx /usr/share/nginx/html \
    && mkdir -p /var/cache/nginx /var/run \
    && chown -R nginx:nginx /var/cache/nginx /var/run

EXPOSE 8080
USER nginx

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1:8080/health/live || exit 1

ENTRYPOINT ["/usr/local/bin/freight-portal-entrypoint"]
